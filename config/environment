# Restart with: systemctl --user restart frame-hev
FRAME_HEV_BUTTON=power
# Stream gain, combined with the current headset volume (0.0 to 1.0).
FRAME_HEV_VOLUME=0.65
# Maximum gap between the first release and the second press.
FRAME_HEV_DOUBLE_TAP_MS=350
# Announce automatically while discharging as the battery passes these levels.
# Comma-separated percentages, or "off". Each level speaks once per discharge.
FRAME_HEV_THRESHOLDS=20,10,5
# Seconds between battery checks for those automatic announcements.
FRAME_HEV_THRESHOLD_POLL=120
# Which gauge to follow: kernel (the OS level the headset shuts down on),
# steamvr (the percentage Steam displays), or auto (SteamVR, then kernel).
FRAME_HEV_BATTERY_SOURCE=kernel
